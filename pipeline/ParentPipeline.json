						"value": "{\n  \"pipeline_name\": \"@{pipeline().Pipeline}\",\n  \"run_id\":\"@{pipeline().RunId}\",\n  \"status\":\"@{activity('Incremental-SQL').Status}\",\n  \"error\":\"@{\n      if(equals(activity('Incremental-SQL').Status,'failed'),\n      string(activity('Incremental-SQL').output.error),'No Error')}\"\n\n}",
						"type": "Expression"
					}
				}
			}
