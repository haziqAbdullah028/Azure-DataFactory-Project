{
	"name": "Golddataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureADFProjectEndtoEnd",
						"type": "LinkedServiceReference"
					},
					"name": "DimAirline"
				},
				{
					"linkedService": {
						"referenceName": "AzureADFProjectEndtoEnd",
						"type": "LinkedServiceReference"
					},
					"name": "DimFlight"
				},
				{
					"linkedService": {
						"referenceName": "AzureADFProjectEndtoEnd",
						"type": "LinkedServiceReference"
					},
					"name": "FactBookings"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureADFProjectEndtoEnd",
						"type": "LinkedServiceReference"
					},
					"name": "Airlinesink"
				},
				{
					"linkedService": {
						"referenceName": "AzureADFProjectEndtoEnd",
						"type": "LinkedServiceReference"
					},
					"name": "FlightSink"
				}
			],
			"transformations": [
				{
					"name": "AirlineJoin"
				},
				{
					"name": "SkipDuplicColumns"
				},
				{
					"name": "AilineAggregate"
				},
				{
					"name": "RankingColumns"
				},
				{
					"name": "filterTop5"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "FlightJoin"
				},
				{
					"name": "RemoveDupColumns"
				},
				{
					"name": "FlightAgreegate"
				},
				{
					"name": "RemoveNulls"
				},
				{
					"name": "Ranking"
				},
				{
					"name": "filterTop"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirline') ~> DimAirline",
				"source(output(",
				"          flight_id as string,",
				"          flight_number as string,",
				"          departure_timestamp as string,",
				"          arrival_timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimFlight') ~> DimFlight",
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as integer,",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'FactBooking') ~> FactBookings",
				"FactBookings, DimAirline join(FactBookings@airline_id == DimAirline@airline_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> AirlineJoin",
				"AirlineJoin select(mapColumn(",
				"          booking_id,",
				"          passenger_id,",
				"          flight_id,",
				"          airline_id = FactBookings@airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          airline_id = DimAirline@airline_id,",
				"          airline_name,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SkipDuplicColumns",
				"SkipDuplicColumns aggregate(groupBy(airline_name),",
				"     Total_Sales = sum(ticket_cost)) ~> AilineAggregate",
				"AilineAggregate window(desc(Total_Sales, true),",
				"     top_ranking = denseRank()) ~> RankingColumns",
				"RankingColumns filter(top_ranking<=5) ~> filterTop5",
				"DimFlight derive(flight_id = toInteger(flight_id)) ~> derivedColumn1",
				"FactBookings, derivedColumn1 join(FactBookings@flight_id == derivedColumn1@flight_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> FlightJoin",
				"FlightJoin select(mapColumn(",
				"          booking_id,",
				"          passenger_id,",
				"          flight_id = FactBookings@flight_id,",
				"          airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          flight_id = derivedColumn1@flight_id,",
				"          flight_number,",
				"          departure_timestamp,",
				"          arrival_timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveDupColumns",
				"RemoveDupColumns aggregate(groupBy(flight_number),",
				"     TotalCost = sum(ticket_cost)) ~> FlightAgreegate",
				"FlightAgreegate filter(!isNull(flight_number) && !isNull(TotalCost)) ~> RemoveNulls",
				"RemoveNulls window(desc(TotalCost, true),",
				"     TopCost = denseRank()) ~> Ranking",
				"Ranking filter(TopCost<6) ~> filterTop",
				"filterTop5 alterRow(insertIf(1==1)) ~> alterRow1",
				"filterTop alterRow(insertIf(1==1)) ~> alterRow2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'AirlineView',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Airlinesink",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'FlightView',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FlightSink"
			]
		}
	}
}